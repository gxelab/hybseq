// hybseq: pangenome-graph processing of interspecies hybrid genomic data
// (pooled DNA-seq and RNA-seq) with Minigraph-Cactus and vg.

manifest {
    name            = 'hybseq'
    description     = 'Pangenome-graph (Minigraph-Cactus + vg) analysis of interspecific hybrids: pooled DNA-seq and RNA-seq'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
}

params {

    // ---- inputs (no hardcoded cluster paths) ----
    samplesheet = "${projectDir}/assets/samplesheet.csv"   // columns: sample,assay,fastq_1,fastq_2
    assemblies  = "${projectDir}/assets/assemblies.txt"    // Minigraph-Cactus seqfile: name<TAB>fasta per line
    gtf         = null                                     // required for --run rnaseq|both

    // ---- graph naming ----
    ref_name    = 'ref'        // cactus --reference; GTF rename prefix; must match the seqfile reference name
    outname     = 'pangenome'  // cactus --outName; prefixes all graph artifacts

    // ---- outputs ----
    outdir            = "${launchDir}/results"
    publish_dir_mode  = 'copy'    // 'symlink' recommended for large GAMs

    // ---- which workflows to run ----
    run = 'both'                 // both | dnaseq | rnaseq

    // ---- containers ----
    // vg 1.73 and cactus 3.1.4 are the versions the pipeline is developed and
    // tested against. The bcftools tag is a placeholder: pin it to whatever is
    // available on your cluster (no particular version is required).
    vg_container       = 'quay.io/vgteam/vg:v1.73.0'
    cactus_container   = 'quay.io/biocontainers/cactus:3.1.4'
    bcftools_container = 'quay.io/biocontainers/bcftools:1.19--h3ea31c5_0'

    // ---- apptainer profile: local SIF overrides (machine-specific paths) ----
    vg_sif       = null
    cactus_sif   = null
    bcftools_sif = null

    // ---- resources (thread counts used by the tools) ----
    giraffe_threads    = 16    // vg giraffe -t
    pack_threads       = 16    // vg pack -t
    call_threads       = 4     // vg call -t
    mpmap_threads      = 16     // vg mpmap -t
    rna_threads        = 8     // vg rna --threads
    gcsa_threads       = 4     // vg index -t (GCSA build)
    cactus_cons_cores  = 16    // cactus-pangenome --consCores
    cactus_index_cores = 16    // cactus-pangenome --indexCores
    cactus_mg_cores    = 16    // cactus-pangenome --mgCores
    cactus_map_cores   = 4     // cactus-pangenome --mapCores

    // ---- fixed values ----
    min_mapq        = 5        // vg pack -Q (ignore reads with MAPQ below this)
    gcsa_tmpdir     = 'tmp'    // vg index -b temporary directory (work-dir relative)
    rna_call_sample = null     // null -> use the sample id for vg call -s; set to a fixed name to override
}

process {

    cpus   = 1
    memory = 8.GB
    time   = 8.h

    withName: 'CACTUS_PANGENOME' {
        cpus   = 16
        memory = 64.GB    // estimate; adjust to your assemblies
        time   = 48.h     // estimate; adjust to your assemblies
    }
    withName: 'VG_GIRAFFE'  { cpus = params.giraffe_threads; memory = 16.GB }
    withName: 'VG_PACK_DNA' { cpus = params.pack_threads }
    withName: 'VG_PACK_RNA' { cpus = params.pack_threads }
    withName: 'VG_CALL_DNA' { cpus = params.call_threads }
    withName: 'VG_CALL_RNA' { cpus = params.call_threads }
    withName: 'VG_MPMAP'    { cpus = params.mpmap_threads; time = 240.h }
    withName: 'VG_RNA'      { cpus = params.rna_threads }
    withName: 'VG_INDEX_GCSA' { cpus = params.gcsa_threads;  memory = 16.GB }
    // VG_INDEX_DIST2, VG_INDEX_XG, VG_PRUNE, VG_SNARLS, VG_INDEX_DIST_RNA and the
    // BCFTOOLS_* steps take no -t flag -> cpus = 1.
}

profiles {

    docker {
        docker.enabled = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // Local SIF paths override the registry images when provided, e.g.:
        // -profile apptainer --vg_sif /path/to/vg.sif --cactus_sif /path/to/cactus.sif
        params.vg_container       = params.vg_sif       ?: params.vg_container
        params.cactus_container   = params.cactus_sif   ?: params.cactus_container
        params.bcftools_container = params.bcftools_sif ?: params.bcftools_container
    }

    test {
        // Tiny synthetic inputs (neutral names: ref_a/ref_b, dna_*, rna_*) for the
        // stub-run smoke test. Run: ./nextflow run . -profile test -stub-run
        params.samplesheet = "${projectDir}/test/samplesheet.csv"
        params.assemblies  = "${projectDir}/test/assemblies.txt"
        params.gtf         = "${projectDir}/test/data/ref_a.gtf"
        params.outdir      = "${launchDir}/test/results"
        params.ref_name    = 'ref_a'
        params.outname     = 'test'

        params.giraffe_threads    = 1
        params.pack_threads       = 1
        params.call_threads       = 1
        params.mpmap_threads      = 1
        params.rna_threads        = 1
        params.gcsa_threads       = 1
        params.cactus_cons_cores  = 1
        params.cactus_index_cores = 1
        params.cactus_mg_cores    = 1
        params.cactus_map_cores   = 1

        // Explicit withName overrides: the base process block binds the thread
        // params, and profile-level params do not propagate to it.
        process {
            withName: 'CACTUS_PANGENOME' { cpus = 1; memory = 1.GB; time = 1.h }
            withName: 'VG_GIRAFFE'       { cpus = 1; memory = 1.GB }
            withName: 'VG_PACK_DNA'      { cpus = 1 }
            withName: 'VG_PACK_RNA'      { cpus = 1 }
            withName: 'VG_CALL_DNA'      { cpus = 1 }
            withName: 'VG_CALL_RNA'      { cpus = 1 }
            withName: 'VG_MPMAP'         { cpus = 1 }
            withName: 'VG_RNA'           { cpus = 1 }
            withName: 'VG_INDEX_GCSA'    { cpus = 1; memory = 1.GB }
        }
    }
}
